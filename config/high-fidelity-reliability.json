{
  "schema_version": 1,
  "model_id": "HIGH_FIDELITY_RELIABILITY",
  "date": "2026-08-21",
  "doctrine": "Engineering maturity, creative maturity, and fidelity reliability are independent. Functional output never implies excellent output.",
  "axes": {
    "engineering_maturity": {
      "E0": "unavailable",
      "E1": "conceptual",
      "E2": "operational",
      "E3": "verified",
      "E4": "integrated",
      "E5": "governed"
    },
    "creative_maturity": {
      "C0": "primitive / unresolved",
      "C1": "blockout",
      "C2": "functional",
      "C3": "coherent",
      "C4": "polished",
      "C5": "production",
      "C6": "signature"
    },
    "fidelity_reliability": {
      "R0": "subjective / unmanaged",
      "R1": "rubric exists",
      "R2": "evidence captured",
      "R3": "automated diagnostics plus specialist review",
      "R4": "regression protected",
      "R5": "repeatably converges through independent and human evidence"
    }
  },
  "non_inheritance_rules": [
    "PACKAGED_BUILD_PASS does not imply GAME_QUALITY_PASS",
    "VALID_GLB does not imply THREE_D_ART_QUALITY_PASS",
