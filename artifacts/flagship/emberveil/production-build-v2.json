{
  "build_id": "emberveil-v2-production",
  "version": "2.0.0",
  "description": "Production-grade Emberveil build: corrected materials, motivated 3-point lighting, high-quality turntable + beauty render",
  "session_blend": "session.blend",
  "ops": [
    {
      "id": "01-scene-rebuild",
      "op": "scene.create",
      "params": {
        "world_color": [0.02, 0.015, 0.01],
        "objects": [
          {"type": "empty", "name": "Emberveil_root", "location": [0, 0, 0]}
        ],
        "camera": {
          "name": "Cam",
          "lens_mm": 55,
          "x": 6.0,
          "y": -7.0,
          "z": 3.0,
          "look_at": [0, 0, 1.2]
        },
        "lights": [
          {"type": "sun", "name": "CoolRim", "x": -4, "y": -6, "z": 10, "energy": 0.8},
          {"type": "point", "name": "EmberCoreLight", "x": 0.0, "y": 0.0, "z": 0.85, "energy": 150},
          {"type": "point", "name": "FillLight", "x": 1.5, "y": -2.0, "z": -0.3, "energy": 30}
        ]
      },
      "note": "Clean rebuild with full 3-light rig: CoolRim (sun), EmberCoreLight (point, warm), FillLight (point, soft). scene.create clears scene."
    },
    {
      "id": "02-mesh-bell",
      "op": "mesh.lathe",
      "params": {
        "name": "glass_bell",
        "segments": 96,
        "profile": [
          [0.0, 0.25],
          [0.35, 0.3],
          [0.65, 0.55],
          [0.85, 1.0],
          [0.95, 1.5],
          [0.9, 1.9],
          [0.75, 2.1],
          [0.5, 2.2],
          [0.0, 2.25]
        ],
        "location": [0, 0, 0.25]
      },
      "note": "Bell jar: flared base tapering to dome. 96 segments for smooth glass surface."
    },
    {
      "id": "03-mesh-core",
      "op": "mesh.lathe",
      "params": {
        "name": "ember_core",
        "segments": 64,
        "profile": [
          [0.0, 0.4],
          [0.15, 0.5],
          [0.25, 0.7],
          [0.3, 0.9],
          [0.25, 1.1],
          [0.15, 1.2],
          [0.0, 1.25]
        ],
        "location": [0, 0, 0.4]
      },
      "note": "Organic ember core inside the bell."
    },
    {
      "id": "04-mesh-band",
      "op": "mesh.lathe",
      "params": {
        "name": "brass_band",
        "segments": 96,
        "profile": [
          [0.88, 1.0],
          [0.98, 1.0],
          [0.98, 1.12],
          [0.88, 1.12]
        ],
        "location": [0, 0, 0]
      },
      "note": "Brass band at bell's widest circumference."
    },
    {
      "id": "05-mesh-filigree",
      "op": "mesh.lathe",
      "params": {
        "name": "filigree_arc",
        "segments": 48,
        "profile": [
          [0.9, 1.12],
          [0.95, 1.3],
          [0.85, 1.6],
          [0.7, 1.85],
          [0.55, 2.0]
        ],
        "location": [0, 0, 0]
      },
      "note": "Filigree arc from brass band upward along bell."
    },
    {
      "id": "06-filigree-array",
      "op": "mesh.radial_array",
      "params": {
        "name": "filigree_arc",
        "count": 3
      },
      "note": "3 arcs at 120-degree intervals."
    },
    {
      "id": "07-mesh-plinth",
      "op": "mesh.lathe",
      "params": {
        "name": "plinth",
        "segments": 96,
        "profile": [
          [3.4, 0.0],
          [3.6, 0.0],
          [3.6, 0.12],
          [3.4, 0.12]
        ],
        "location": [0, 0, 0]
      },
      "note": "Flat display plinth."
    },
    {
      "id": "08-parent-all",
      "op": "scene.parent",
      "params": {
        "root": "Emberveil_root",
        "children": ["glass_bell", "ember_core", "brass_band", "filigree_arc", "filigree_arc_01", "filigree_arc_02", "plinth"]
      },
      "note": "Parent all meshes under root for coherent float animation."
    },
    {
      "id": "09-material-glass",
      "op": "material.subsurface",
      "params": {
        "name": "Emberveil_Glass_v2",
        "base_color": [1.0, 0.702, 0.278],
        "roughness": 0.05,
        "transmission": 0.95,
        "ior": 1.5,
        "subsurface": 0.3,
        "subsurface_color": [1.0, 0.7, 0.3],
        "assign_to": ["glass_bell"]
      },
      "note": "Amber glass: 95% transmission, 0.05 roughness, IOR 1.5, 0.3 subsurface scatter."
    },
    {
      "id": "10-material-ember-core",
      "op": "material.construct",
      "params": {
        "name": "Emberveil_Core_v2",
        "base_color": [1.0, 0.478, 0.102],
        "metallic": 0.0,
        "roughness": 0.4,
        "emission": [1.0, 0.478, 0.102],
        "emission_strength": 25.0,
        "assign_to": ["ember_core"]
      },
      "note": "Warm orange emission at 25W strength. Noise-driven flicker needs material.op_noise_texture (see gaps)."
    },
    {
      "id": "11-material-brass",
      "op": "material.construct",
      "params": {
        "name": "Emberveil_Brass_v2",
        "base_color": [0.722, 0.525, 0.043],
        "metallic": 0.9,
        "roughness": 0.25,
        "emission": [0.3, 0.2, 0.02],
        "emission_strength": 0.1,
        "assign_to": ["brass_band", "filigree_arc", "filigree_arc_01", "filigree_arc_02"]
      },
      "note": "Warm brass: high metallic, 0.25 roughness, subtle emission for warmth."
    },
    {
      "id": "12-material-plinth",
      "op": "material.construct",
      "params": {
        "name": "Emberveil_Plinth_v2",
        "base_color": [0.102, 0.102, 0.102],
        "metallic": 0.0,
        "roughness": 0.4,
        "assign_to": ["plinth"]
      },
      "note": "Dark basalt: zero metallic, 0.4 roughness. Corrects v1 error."
    },
    {
      "id": "13-material-inspect",
      "op": "material.inspect",
      "params": {},
      "note": "Verify all 4 materials assigned correctly."
    },
    {
      "id": "14-float-animation",
      "op": "animation.float",
      "params": {
        "name": "Emberveil_root",
        "frame_start": 1,
        "frame_end": 96,
        "amplitude": 0.18,
        "cycles": 2,
        "sway_degrees": 2.5
      },
      "note": "Idle float: gentle bob + sway. Loop-safe."
    },
    {
      "id": "15-scene-inspect",
      "op": "scene.inspect",
      "params": {},
      "note": "Final scene state check before renders."
    },
    {
      "id": "16-turntable",
      "op": "render.turntable",
      "params": {
        "target": [0, 0, 0.8],
        "radius": 5.0,
        "height": 1.8,
        "frames": 24,
        "resolution": [1920, 1080],
        "engine": "CYCLES",
        "samples": 128,
        "camera": {
          "name": "TurntableCam",
          "lens_mm": 50
        }
      },
      "note": "Full 360 turntable. 1920x1080, 128 samples, denoising ON."
    },
    {
      "id": "17-beauty-shot",
      "op": "render.preview",
      "params": {
        "frame": 1,
        "resolution": [1920, 1080],
        "engine": "CYCLES",
        "samples": 256
      },
      "note": "Beauty shot from flattering 3/4 angle. 256 samples."
    },
    {
      "id": "18-export-glb",
      "op": "asset.export_glb",
      "params": {
        "out_path": "emberveil-v2.glb"
      },
      "note": "Export final asset."
    }
  ]
}
