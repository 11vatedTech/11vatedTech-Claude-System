# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# PostgreSQL (see `growthos setup database`)
DATABASE_URL=postgresql+asyncpg://growthos:CHANGE_ME@127.0.0.1:5433/growthos

# Security (generate a long random string)
SECRET_KEY=change-me-development-only

# Local AI (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_FAST_MODEL=qwen3.5:9b
OLLAMA_DEEP_MODEL=qwen2.5:32b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Founder identity (used for SMS allowlist)
FOUNDER_EMAIL=
FOUNDER_PHONE=
